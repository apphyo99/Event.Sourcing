<Project>

  <!-- Common properties for all projects -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>NU1603;NU1604;NU1605;NU1608;NU1701;NU1602;NU1202;NU1101</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Source code analysis -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Package versions: Directory.Packages.props (Central Package Management) -->

  <!-- Common source files for analyzers -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <!-- Assembly metadata -->
  <PropertyGroup>
    <Company>Event Sourcing Architecture</Company>
    <Product>Event Sourcing + CQRS</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

</Project>
